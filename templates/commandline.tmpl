<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Gangplank</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      type="text/css"
      media="screen"
      href="{{ .HTTPPath }}/static/style.css"
    />
    <script>
      (function () {
        const savedTheme = localStorage.getItem("gangplank-theme");
        if (savedTheme) {
          document.documentElement.setAttribute("data-theme", savedTheme);
        } else if (
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <div class="app-wrapper">
      <header class="app-header">
        <div class="header-container">
          <a href="{{ .HTTPPath }}/" class="brand-link">
            <svg
              class="brand-logo"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="m4.93 4.93 4.24 4.24" />
              <path d="m14.83 9.17 4.24-4.24" />
              <path d="m14.83 14.83 4.24 4.24" />
              <path d="m9.17 14.83-4.24 4.24" />
              <circle cx="12" cy="12" r="4" />
            </svg>
            <span>Gangplank</span>
            <span class="brand-badge">OIDC</span>
          </a>

          <nav class="header-nav">
            <button
              id="theme-toggle"
              type="button"
              class="btn-icon"
              title="Toggle theme"
              aria-label="Toggle theme"
              onclick="toggleTheme()"
            >
              <svg
                class="icon theme-icon-sun"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="5" />
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
              </svg>
              <svg
                class="icon theme-icon-moon"
                viewBox="0 0 24 24"
                stroke-width="2"
              >
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
              </svg>
            </button>

            <a
              class="btn btn-ghost"
              href="{{ .HTTPPath }}/logout"
              rel="noreferrer"
            >
              <svg
                class="icon"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Logout</span>
            </a>
          </nav>
        </div>
      </header>

      <main class="app-main">
        <div class="main-container">
          <div class="welcome-section">
            <h1 class="welcome-title">Welcome, {{ .Username }}</h1>
            <p class="welcome-text">
              Configure OpenID Connect (OIDC) authentication to obtain
              command-line access to your Kubernetes cluster.
            </p>
            <div class="pill-group">
              <span class="pill pill-accent">
                <svg
                  class="icon"
                  style="width: 14px; height: 14px"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polygon points="12 2 2 7 12 12 22 7 12 2" />
                  <polyline points="2 17 12 22 22 17" />
                  <polyline points="2 12 12 17 22 12" />
                </svg>
                Cluster: <span class="pill-strong">{{ .ClusterName }}</span>
              </span>
              {{ if not (eq .Namespace "") }}
              <span class="pill">
                Namespace: <span class="pill-strong">{{ .Namespace }}</span>
              </span>
              {{ end }}
            </div>
          </div>

          <!-- Option 1: Direct Download -->
          <div class="card">
            <div class="card-header">
              <div class="card-title-group">
                <svg
                  class="icon"
                  style="color: var(--primary)"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                <h2 class="card-title">Download Kubeconfig</h2>
              </div>
            </div>
            <p class="card-description">
              Download a preconfigured kubeconfig file for
              <strong>{{ .ClusterName }}</strong> ready to use with kubectl.
            </p>

            <form
              method="GET"
              action="{{ .HTTPPath }}/kubeconf"
              class="kubeconfig-form form-group"
            >
              <label
                for="kubeconfig-filename"
                class="form-label kubeconfig-form-label"
              >
                Customize downloaded filename (optional)
              </label>
              <div class="form-row kubeconfig-form-row">
                <input
                  id="kubeconfig-filename"
                  type="text"
                  name="filename"
                  class="input-text kubeconfig-filename-input"
                  placeholder="{{ .KubeCfgUser }}"
                  autocomplete="off"
                />
                <button type="submit" class="btn btn-primary">
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                  <span>Download File</span>
                </button>
              </div>
            </form>
          </div>

          <div class="section-divider">
            <span>OR CONFIGURE VIA CLI</span>
          </div>

          <!-- Option 2: Command-line Execution -->
          <div class="card">
            <div class="card-header">
              <div class="card-title-group">
                <svg
                  class="icon"
                  style="color: var(--primary)"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="4 17 10 11 4 5" />
                  <line x1="12" y1="19" x2="20" y2="19" />
                </svg>
                <h2 class="card-title">Execute kubectl Commands</h2>
              </div>
            </div>
            <p class="card-description">
              Run the following commands in your local terminal to configure
              your kubectl client:
            </p>

            <div class="code-window">
              <div class="code-window-header">
                <div class="window-controls">
                  <span class="window-dot window-dot-red"></span>
                  <span class="window-dot window-dot-yellow"></span>
                  <span class="window-dot window-dot-green"></span>
                  <span class="code-language">bash</span>
                </div>
                <button
                  type="button"
                  id="copy-btn"
                  class="btn btn-copy"
                  onclick="copyCommands()"
                  title="Copy commands to clipboard"
                >
                  <svg
                    id="copy-icon"
                    class="icon"
                    style="width: 14px; height: 14px"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                    <path
                      d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                    />
                  </svg>
                  <span id="copy-text">Copy commands</span>
                </button>
              </div>
              <pre class="code-block-pre"><code class="code-block-code" id="kubectl-commands">{{ if not (eq .ClusterCA  "") }}echo "{{ .ClusterCA }}" > "ca-{{ .ClusterName }}.pem"
{{ end }}kubectl config set-cluster "{{ .ClusterName }}" --server={{ .APIServerURL }}{{ if not (eq .ClusterCA  "") }} --certificate-authority="ca-{{ .ClusterName }}.pem" --embed-certs{{ end }}
kubectl config set-credentials "{{ .KubeCfgUser }}" \
  --auth-provider=oidc \
  --auth-provider-arg="idp-issuer-url={{ .IssuerURL }}" \
  --auth-provider-arg="client-id={{ .ClientID }}" \
  --auth-provider-arg="client-secret={{ .ClientSecret }}" \
  --auth-provider-arg="refresh-token={{ .RefreshToken }}" \
  --auth-provider-arg="id-token={{ .IDToken }}"{{ if not (eq .IDPCAb64  "") }} \
  --auth-provider-arg="idp-certificate-authority-data={{ .IDPCAb64 }}"{{ end }}
kubectl config set-context "{{ .ClusterName }}" --cluster="{{ .ClusterName }}" --user="{{ .KubeCfgUser }}"{{ if not (eq .Namespace "") }} --namespace="{{ .Namespace }}"{{ end }}
kubectl config use-context "{{ .ClusterName }}"
{{ if not (eq .ClusterCA  "") }}rm "ca-{{ .ClusterName }}.pem"{{ end }}</code></pre>
            </div>
          </div>
        </div>
      </main>

      <footer class="app-footer">
        <p>Gangplank &middot; Kubernetes Authentication</p>
      </footer>
    </div>

    <script>
      function toggleTheme() {
        const currentTheme =
          document.documentElement.getAttribute("data-theme");
        let newTheme = "light";
        if (currentTheme === "light") {
          newTheme = "dark";
        } else if (currentTheme === "dark") {
          newTheme = "light";
        } else {
          const isDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          newTheme = isDark ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", newTheme);
        localStorage.setItem("gangplank-theme", newTheme);
      }

      function copyCommands() {
        const codeElement = document.getElementById("kubectl-commands");
        if (!codeElement) return;

        const textToCopy = codeElement.innerText || codeElement.textContent;
        const copyBtn = document.getElementById("copy-btn");
        const copyText = document.getElementById("copy-text");

        function onSuccess() {
          if (copyBtn && copyText) {
            copyBtn.classList.add("copied");
            copyText.textContent = "Copied!";
            setTimeout(() => {
              copyBtn.classList.remove("copied");
              copyText.textContent = "Copy commands";
            }, 2000);
          }
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard
            .writeText(textToCopy)
            .then(onSuccess)
            .catch(() => fallbackCopy(textToCopy, onSuccess));
        } else {
          fallbackCopy(textToCopy, onSuccess);
        }
      }

      function fallbackCopy(text, callback) {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        textArea.style.position = "fixed";
        textArea.style.left = "-999999px";
        textArea.style.top = "-999999px";
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand("copy");
          if (callback) callback();
        } catch (err) {
          console.error("Fallback copy failed", err);
        }
        document.body.removeChild(textArea);
      }
    </script>
  </body>
</html>
